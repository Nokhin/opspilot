# Live validation only; the normal .env/offline demo is unaffected.
# Copy to .env.live, chmod 600 .env.live, then fill the key/model locally.
OPSPILOT_LLM_PROVIDER=chat_api
OPSPILOT_LLM_BASE_URL=https://openrouter.ai/api/v1
OPSPILOT_LLM_MODEL=
OPSPILOT_LLM_API_KEY=
OPSPILOT_EMBEDDING_PROVIDER=tfidf
OPSPILOT_DATA_DIR=var
OPSPILOT_CORPUS_DIR=corpus/policies
OPSPILOT_REFERENCE_TIME=2026-10-01T00:00:00Z
OPSPILOT_TOP_K=6
OPSPILOT_MAX_TOOL_CALLS=4
OPSPILOT_PROVIDER_TIMEOUT_SECONDS=30
OPSPILOT_PROVIDER_RETRIES=1
# Optional per-million-token rates for a token-only estimate; do not invent prices.
# OpenRouter's actual usage.cost is recorded separately when returned.
OPSPILOT_INPUT_COST_PER_MILLION=
OPSPILOT_OUTPUT_COST_PER_MILLION=
